# Respan gateway (LLM credits + traces) - handed out at kickoff
RESPAN_API_KEY=

# Cognee -> Respan gateway (OpenAI-compatible). Keep the openai/ prefix for Cognee's LiteLLM layer.
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.respan.ai/api
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_PROVIDER=custom
EMBEDDING_ENDPOINT=https://api.respan.ai/api
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Cognee per-user datasets. Must be true before the first cognee import.
ENABLE_BACKEND_ACCESS_CONTROL=true

# Scalekit AgentKit (dashboard: Developers -> API Credentials)
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SLACK_CONNECTION_NAME=slack
GITHUB_CONNECTION_NAME=github-connect

# Demo users. The Scalekit identifier IS the Cognee user email.
USER_ALICE=
USER_BOB=

# Optional. Defaults to <repo>/.cognee_system and <repo>/.data_storage (created automatically).
SYSTEM_ROOT_DIRECTORY=
DATA_ROOT_DIRECTORY=

# Avoid HuggingFace tokenizer downloads (falls back to tiktoken)
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false
NOTION_CONNECTION_NAME=notion
GITHUB_REPO=

# Local small model (Ollama, OpenAI-compatible) for closed-set steps; falls back to the gateway when unreachable
PANTHEON_LOCAL=0
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1:8b
LOCAL_STEPS=route,judge
LOCAL_DECISION_MODEL=nimble:9b   # decision model (Ollama /v1/systemone); empty to disable
PANTHEON_ASYNC_MEMORY=0   # 1 in the long-lived API: remember decisions in the background
